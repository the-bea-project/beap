//// Helpers for the tests: temporary directories, a server per test, and an
//// HTTP client (`beap_test_ffi.erl`) that streams large bodies.

import beap/internal/config
import beap/internal/paths
import beap/internal/server
import gleam/bit_array
import gleam/list
import gleam/result
import simplifile

/// A new, empty directory, as a real path.
pub fn directory(name: String) -> String {
  let assert Ok(path) = paths.real_path(temp_dir(name))
  path
}

@external(erlang, "beap_test_ffi", "temp_dir")
fn temp_dir(name: String) -> String

pub fn write(path: String, content: String) -> Nil {
  let assert Ok(_) = simplifile.create_directory_all(parent(path))
  let assert Ok(_) = simplifile.write(path, content)
  Nil
}

fn parent(path: String) -> String {
  path
  |> paths.split
  |> list.reverse
  |> list.drop(1)
  |> list.reverse
  |> fn(segments) { "/" <> join(segments) }
}

fn join(segments: List(String)) -> String {
  case segments {
    [] -> ""
    [first, ..rest] -> list.fold(rest, first, fn(acc, s) { acc <> "/" <> s })
  }
}

pub fn read(path: String) -> String {
  simplifile.read(path) |> result.unwrap("<missing>")
}

pub fn config(root: String) -> config.Config {
  config.Config(..config.defaults("test"), port: 0, root:)
}

/// Starts a server on a free port and returns the port. Its access log goes
/// nowhere.
pub fn serve(config: config.Config) -> Int {
  silence_output()
  let assert Ok(started) = server.start(config)
  started.port
}

@external(erlang, "beap_test_ffi", "silence_output")
fn silence_output() -> Nil

pub type Response {
  Response(status: Int, headers: List(#(String, String)), body: BitArray)
}

@external(erlang, "beap_test_ffi", "request")
fn raw_request(
  port: Int,
  method: String,
  path: String,
  headers: List(#(String, String)),
  body: BitArray,
) -> #(Int, List(#(String, String)), BitArray)

pub fn request(
  port: Int,
  method: String,
  path: String,
  headers: List(#(String, String)),
  body: BitArray,
) -> Response {
  let #(status, headers, body) = raw_request(port, method, path, headers, body)
  Response(status:, headers:, body:)
}

pub fn get(port: Int, path: String) -> Response {
  request(port, "GET", path, [], <<>>)
}

pub fn put(port: Int, path: String, body: BitArray) -> Response {
  request(port, "PUT", path, [], body)
}

pub fn header(response: Response, name: String) -> Result(String, Nil) {
  list.key_find(response.headers, name)
}

pub fn text(response: Response) -> String {
  let assert Ok(text) = bit_array.to_string(response.body)
  text
}

@external(erlang, "beap_test_ffi", "concurrent_puts")
pub fn concurrent_puts(
  port: Int,
  path: String,
  bodies: List(BitArray),
) -> List(#(Int, List(#(String, String)), BitArray))

/// PUTs `size` generated bytes, 64 KiB at a time: #(status, body, sha256).
@external(erlang, "beap_test_ffi", "upload_stream")
pub fn upload_stream(
  port: Int,
  path: String,
  size: Int,
  chunked: Bool,
  seed: Int,
) -> #(Int, BitArray, BitArray)

/// GETs `path`, hashing the body as it arrives: #(status, size, sha256).
@external(erlang, "beap_test_ffi", "download_digest")
pub fn download_digest(port: Int, path: String) -> #(Int, Int, BitArray)

/// Announces `declared` bytes, sends `sent` of them, and hangs up.
@external(erlang, "beap_test_ffi", "send_partial")
pub fn send_partial(port: Int, path: String, declared: Int, sent: Int) -> Nil

@external(erlang, "beap_test_ffi", "sha256_file")
pub fn sha256_file(path: String) -> BitArray

/// Runs `f`, returning its result and the VM's peak memory growth meanwhile.
@external(erlang, "beap_test_ffi", "memory_peak_during")
pub fn memory_peak_during(f: fn() -> a) -> #(a, Int)

/// Runs `f` in a process that is killed `delay` ms later.
@external(erlang, "beap_test_ffi", "exit_after")
pub fn exit_after(f: fn() -> a, delay: Int) -> Nil

@external(erlang, "timer", "sleep")
pub fn sleep(ms: Int) -> Nil
